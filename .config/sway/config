include outputs
include keybinds
include theme
include swayfx

# Notifications
exec mako

exec swayidle -w \
          timeout 300 'swaylock -f -c 1e1e2e' \
          timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"' \
          before-sleep 'swaylock -f -c 1e1e2e'

bar {
    swaybar_command waybar
}

include /etc/sway/config.d/*

# Waybar popups (bluesink / airlink / soundmix TUIs) float centered
for_window [app_id="^(bluesink|airlink|soundmix)$"] floating enable, resize set 1000 640, move position center
